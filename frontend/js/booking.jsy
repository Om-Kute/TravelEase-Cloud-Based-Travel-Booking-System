let selectedHotel = null;
let currentUser = null;

document.addEventListener("DOMContentLoaded", () => {
    loadBookingPage();

    document
        .getElementById("bookingForm")
        .addEventListener("submit", submitBooking);
});

function loadBookingPage() {

    selectedHotel = JSON.parse(
        localStorage.getItem(CONFIG.LOCAL_STORAGE.BOOKINGS)
    );

    currentUser = JSON.parse(
        localStorage.getItem(CONFIG.LOCAL_STORAGE.USER)
    );

    if (!selectedHotel) {
        alert("No hotel selected.");
        window.location.href = "hotels.html";
        return;
    }

    renderSummary();

    if (currentUser) {
        document.getElementById("guestName").value = currentUser.fullName || "";
        document.getElementById("guestEmail").value = currentUser.email || "";
        document.getElementById("guestMobile").value = currentUser.mobile || "";
    }
}

function renderSummary() {

    document.getElementById("bookingSummary").innerHTML = `
        <h3>${selectedHotel.name}</h3>
        <p><strong>Location:</strong> ${selectedHotel.location}</p>
        <p><strong>Price:</strong> ₹${selectedHotel.price}</p>
        <p><strong>Rating:</strong> ⭐ ${selectedHotel.rating}</p>
    `;
}

function validateDates(checkIn, checkOut) {

    const today = new Date();
    today.setHours(0,0,0,0);

    const inDate = new Date(checkIn);
    const outDate = new Date(checkOut);

    if (inDate < today) {
        alert("Check-in date cannot be in the past.");
        return false;
    }

    if (outDate <= inDate) {
        alert("Check-out date must be after check-in.");
        return false;
    }

    return true;
}

async function submitBooking(e) {

    e.preventDefault();

    const guestName = document.getElementById("guestName").value.trim();
    const guestEmail = document.getElementById("guestEmail").value.trim();
    const guestMobile = document.getElementById("guestMobile").value.trim();
    const checkInDate = document.getElementById("checkIn").value;
    const checkOutDate = document.getElementById("checkOut").value;
    const totalGuests = parseInt(document.getElementById("guests").value);

    if (
        !guestName ||
        !guestEmail ||
        !guestMobile ||
        !checkInDate ||
        !checkOutDate
    ) {
        alert("Please fill all fields.");
        return;
    }

    if (!validateDates(checkInDate, checkOutDate)) return;

    const bookingData = {
        hotel: selectedHotel._id,
        guestName,
        guestEmail,
        guestMobile,
        checkInDate,
        checkOutDate,
        totalGuests,
        roomType: "Standard"
    };

    try {

        const response = await api.post(
            API.BOOKINGS.CREATE,
            bookingData
        );

        const paymentBooking = {
            bookingId: response.booking._id,
            hotelId: selectedHotel._id,
            hotelName: selectedHotel.name,
            city: selectedHotel.location,
            price: selectedHotel.price,
            checkIn: checkInDate,
            checkOut: checkOutDate,
            guests: totalGuests
        };

        localStorage.setItem(
            CONFIG.LOCAL_STORAGE.BOOKINGS,
            JSON.stringify(paymentBooking)
        );

        alert("Booking Successful!");

        window.location.href = "payment.html";

    } catch (error) {

        console.error(error);

        alert(error.message || "Booking Failed");
    }
}

console.log("Booking Module Loaded");
