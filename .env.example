# ======================================================
# TravelEase - Environment Configuration
# Copy this file to backend/.env and update the values.
# ======================================================

# ==========================
# APPLICATION
# ==========================
NODE_ENV=development
PORT=5000
APP_NAME=TravelEase

# ==========================
# FRONTEND
# ==========================
CLIENT_URL=http://localhost:3000

# ==========================
# DATABASE
# ==========================
MONGODB_URI=mongodb://127.0.0.1:27017/travelease

# For MongoDB Atlas
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/travelease

# ==========================
# JWT
# ==========================
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRE=7d

# ==========================
# AWS
# ==========================
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
AWS_REGION=ap-south-1
AWS_S3_BUCKET=travelease-storage

# ==========================
# EMAIL (SMTP)
# ==========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password

# ==========================
# PAYMENT GATEWAY
# ==========================

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_SECRET=xxxxxxxxxxxxxxxxxxxx

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxx

# ==========================
# FILE UPLOAD
# ==========================
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,image/webp

# ==========================
# SECURITY
# ==========================
BCRYPT_SALT_ROUNDS=10

# ==========================
# LOGGING
# ==========================
LOG_LEVEL=info

# ==========================
# CORS
# ==========================
CORS_ORIGIN=http://localhost:3000